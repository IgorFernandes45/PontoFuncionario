NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role IGNORA RLS. Só no servidor, nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Sprint 6 — agente de IA. Também só no servidor.
ANTHROPIC_API_KEY=

# Envio de e-mail de produto (aviso de mudança de escala). Sem estas duas,
# os avisos ficam na fila e nada se perde.
RESEND_API_KEY=
EMAIL_REMETENTE=
